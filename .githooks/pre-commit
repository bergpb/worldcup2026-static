#!/usr/bin/env bash
# Installed via: git config core.hooksPath .githooks (see `make install-hooks`)
set -e

cd "$(git rev-parse --show-toplevel)"

echo "→ pre-commit: build check"
python3 build.py >/dev/null

echo "→ pre-commit: partial markers must stay empty in committed source"
python3 scripts/check_empty_markers.py

echo "→ pre-commit: JS unit tests"
npm test --silent

echo "→ pre-commit: Python unit tests"
python3 -m unittest discover -s tests >/dev/null

echo "✓ pre-commit checks passed"
